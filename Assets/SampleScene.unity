--- !u!114 &1531568133
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1531568131}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c831eb8f3a5419f4f943e25687c4ced7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialog2
  ScriptText_dialogue: {fileID: 687794600}
  ScriptText_dialoguename: {fileID: 1623721874}
  ScriptImage_portrait: {fileID: 1307633372}
  dialogue:
  - "\uC7A5\uC18C: \uD3D0\uC1C4\uB41C \uBC84\uC2A4 \uCC28\uACE0\uC9C0. \uBAA9\uC801:
    \uC8FC\uBBFC \uB300\uD53C \uACBD\uB85C \uD655\uBCF4. \uC804\uD22C \uC804 [\uBC84\uC2A4
    \uC548\uC5D0 \uC8FC\uBBFC\uB4E4\uC774 \uBAB8\uC744 \uC219\uC774\uACE0 \uC788\uB2E4.
    \uCC28\uACE0\uC9C0 \uC785\uAD6C\uC5D0\uC11C \uD0D0\uC870\uB4F1\uC774 \uC9C0\uB098\uAC04\uB2E4.]
    \uB3C4\uC724: \uBC84\uC2A4 \uC138 \uB300. \uC5F0\uB8CC\uB294 \uB450 \uB300\uBD84\uC774\uAD70.
    \uC0AC\uB78C\uC744 \uB098\uB220 \uD0DC\uC6CC\uC57C\uACA0\uC5B4. \uC720\uB098:
    \uBD80\uC0C1\uC790\uB294 \uC55E\uCC28\uB85C \uC62E\uAE38\uAC8C\uC694. \uB4A4\uCC28\uC5D0\uB294
    \uC544\uC774\uB4E4 \uBCF4\uD638\uC790\uAC00 \uAC19\uC774 \uD0C0\uC57C \uD574\uC694.
    \uC11C\uB9B0: \uD070\uAE38\uC740 \uC804\uBD80 \uAC80\uBB38 \uC911\uC774\uC57C.
    \uC815\uBE44 \uD130\uB110\uB85C \uBE60\uC9C0\uBA74 \uB418\uB294\uB370 \uCD9C\uC785\uBB38
    \uC804\uC6D0\uC774 \uB04A\uACBC\uC5B4. \uC2DC\uD6C4: \uC774\uB7F0 \uBB38\uC5D0\uB294
    \uAF2D \uC190\uC7A1\uC774\uAC00 \uC548 \uB2EC\uB824 \uC788\uB354\uB77C. \uBBF8\uB798
    \uAE30\uC220\uC758 \uBE44\uADF9\uC774\uC9C0. \uC9C0\uD718\uAD00: \uC218\uB3D9
    \uAC1C\uBC29 \uC7A5\uCE58\uB294? \uC11C\uB9B0: \uCC28\uACE0\uC9C0 \uBC18\uB300\uD3B8
    \uBC30\uC804\uC2E4. \uADF8\uB7F0\uB370 \uCD94\uC801 \uB4DC\uB860\uC774 \uBA3C\uC800
    \uB3C4\uCC29\uD588\uC5B4. \uCC28\uB7C9\uC744 \uBC1C\uACAC\uD558\uBA74 \uC704\uCE58\uAC00
    \uB118\uC5B4\uAC00. \uB3C4\uC724: \uB0B4\uAC00 \uBC30\uC804\uC2E4\uAE4C\uC9C0
    \uAC04\uB2E4. \uBC84\uC2A4 \uCABD\uC73C\uB85C\uB294 \uD55C \uBC1C\uB3C4 \uBABB
    \uBCF4\uB0B4. \uC9C0\uD718\uAD00: \uB4DC\uB860\uC744 \uC815\uB9AC\uD558\uACE0
    \uBB38\uC744 \uC5F0\uB2E4. \uCD9C\uBC1C \uC2E0\uD638 \uC804\uAE4C\uC9C0 \uC2DC\uB3D9\uC740
    \uAC78\uC9C0 \uB9C8. \uC804\uD22C \uD6C4 [\uCCA0\uBB38\uC774 \uCC9C\uCC9C\uD788
    \uC62C\uB77C\uAC04\uB2E4. \uBC84\uC2A4 \uC6B4\uC804\uC0AC\uAC00 \uC190\uC744
    \uB4E4\uC5B4 \uC2E0\uD638\uD55C\uB2E4.] \uC6B4\uC804\uC0AC: \uB2E4\uC74C \uAD50\uCC28\uB85C\uAE4C\uC9C0\uB294
    \uC555\uB2C8\uB2E4. \uADF8\uB2E4\uC74C\uC5D4 \uC5B4\uB514\uB85C \uAC00\uC8E0?
    \uC11C\uB9B0: \uB300\uD53C\uC18C \uC88C\uD45C\uB97C \uACC4\uAE30\uD310\uC5D0
    \uB123\uC5C8\uC5B4\uC694. \uC548\uB0B4\uAC00 \uB04A\uAE30\uBA74 \uD30C\uB780
    \uBC30\uAD00\uC744 \uB530\uB77C\uAC00\uC138\uC694. \uC720\uB098: \uB3C4\uCC29\uD558\uBA74
