  m_Script: {fileID: 11500000, guid: c831eb8f3a5419f4f943e25687c4ced7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::tori_start
  ScriptText_dialogue: {fileID: 879580510}
  dialogue:
  - "\uD1A0\uB9AC\uC57C \uB124\uAC00 \uB0B4 usb \uD6D4\uCCD0 \uAC04 \uBC94\uC778\uC744
    \uBD24\uB2E4\uB358\uB370 \uC815\uB9D0\uC774\uC57C??"
  - "\uB098 \uC880 \uB3C4\uC640\uC918 \uC81C\uBC1C.."
  - "\uB108\uB3C4 \uB0A0 \uB3C4\uC640\uC8FC\uBA74 \uB098\uB3C4 \uB110 \uB3C4\uC640\uC904\uAC8C"
  - "\uBB58 \uB3C4\uC640\uC8FC\uBA74 \uB420\uAE4C??"
  - "\uB0B4 \uBC2D\uC5D0 \uC788\uB294 \uB2F9\uADFC\uC774 \uB108\uBB34 \uB9CE\uC544\uC11C
    \uBA87 \uAC1C\uC778\uC9C0 \uBAA8\uB974\uACA0\uC5B4..!"
  - "\uADF8\uB7F0 \uAC70\uB77C\uBA74 \uBB38\uC81C\uC5C6\uC9C0! \uB0B4\uAC00 \uB2F9\uADFC\uC758
    \uAC1C\uC218\uB97C \uB2E4 \uC138\uC8FC\uBA74 \uB418\uB294 \uAC70\uC9C0??"
  - "\uAC1C\uC218\uAE4C\uC9C0\uB294 \uAD1C\uCC2E\uACE0, \uD640\uC218\uC778\uC9C0
    \uC9DD\uC218\uC778\uC9C0\uB9CC \uC54C\uB824\uC8FC\uBA74 \uB3FC!"
  - "\uC774\uBC88 \uAC8C\uC784\uC740 \uD640\uC9DD \uAC8C\uC784\uC774\uC57C \uC798
    \uC54C\uACE0 \uC788\uC9C0??"
  dialogue_count: 0
