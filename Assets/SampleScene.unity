--- !u!114 &1817837897
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1817837895}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cee4fa200557e4a42ad8d9f49c8a22cb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialog1
  ScriptText_dialogue: {fileID: 140923428}
  ScriptText_dialoguename: {fileID: 426875000}
  ScriptImage_portrait: {fileID: 695059283}
  dialogue:
  - "[\uBD88 \uAEBC\uC9C4 \uC0C1\uC810\uB4E4. \uAC04\uD310 \uD558\uB098\uB9CC \uAE5C\uBE61\uC778\uB2E4.
    \uAE38 \uAC74\uB108 \uC804\uAD11\uD310\uC5D0\uB294 \u2018\uB2F9\uC2E0\uC758 \uB0B4\uC77C\uC744
    \uC9C0\uD0B5\uB2C8\uB2E4. \uC5D0\uB374\u2019\uC774 \uB5A0 \uC788\uB2E4.]"
  - " \uB0B4\uC77C\uC740 \uC9C0\uCF1C\uC900\uB2E4\uB294\uB370 \uC624\uB298 \uC804\uAE30\uB294
    \uB04A\uACBC\uB124. \uACE0\uAC1D\uC13C\uD130 \uC5B4\uB514\uC57C?"
  - " \uB18D\uB2F4\uD560 \uC0C1\uD669 \uC544\uB2C8\uC57C. \uC774 \uAD6C\uC5ED \uC2DC\uBBFC
    \uB4F1\uB85D\uC774 \uC77C\uAD04 \uB9D0\uC18C\uB410\uC5B4. \uC0AC\uB78C\uC740
    \uADF8\uB300\uB85C \uC788\uB294\uB370 \uD589\uC815\uC0C1 \uAC70\uC8FC\uC790\uAC00
    \uC5C6\uC5B4."
  - "\uADF8\uB798\uC11C \uB2E8\uC18D \uBCD1\uB825\uC774 \uB4E4\uC5B4\uC628 \uAC70\uAD70.
    \uC5C6\uB294 \uC0AC\uB78C\uC740 \uB54C\uB824\uB3C4 \uB41C\uB2E4\uB294 \uAC74\uAC00."
  - " \uBBF8\uB4F1\uB85D \uCCB4\uB958\uC790\uB294 \uB3C4\uB85C \uC911\uC559\uC5D0
    \uC9D1\uACB0\uD558\uC2ED\uC2DC\uC624. \uC800\uD56D \uD589\uC704\uB294 \uACA9\uB9AC
    \uC0AC\uC720\uC5D0 \uD574\uB2F9\uD569\uB2C8\uB2E4."
  - "\uC154\uD130 \uC548\uC5D0 \uC0AC\uB78C\uC774 \uC788\uC5B4\uC694. \uC544\uC774
    \uB458\uD558\uACE0, \uAC78\uC744 \uC218 \uC5C6\uB294 \uC5B4\uB978 \uD55C \uBA85.
    \uBB38\uC744 \uC5F4\uBA74 \uBC14\uB85C \uC0AC\uC120\uC5D0 \uB4E4\uC5B4\uAC00\uC694."
  - " \uB3C4\uC724\uC740 \uC0C1\uAC00 \uC55E\uC744 \uB9C9\uC544. \uC2DC\uD6C4, \uAC74\uB108\uD3B8
    \uC0AC\uC218\uBD80\uD130. \uC720\uB098\uB294 \uB0B4\uAC00 \uC2E0\uD638\uD558\uBA74
    \uC8FC\uBBFC\uC744 \uB370\uB9AC\uACE0 \uB098\uC640."
  - "\uD655\uC778. \uC800\uCABD \uB208\uC740 \uB098\uD55C\uD14C \uB3CC\uB824\uB193\uC744\uAC8C."
  dialoguename:
  - 
  - "\uC2DC\uD6C4"
  - "\uC11C\uB9B0"
  - "\uB3C4\uC724"
  - "\uC5D0\uB374 \uBC29\uC1A1"
